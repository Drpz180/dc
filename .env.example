# === App ===
# Render: https://seu-app.onrender.com  |  XAMPP: http://localhost/vakapostgree/public
BASE_URL=https://seu-app.onrender.com

# === Admin ===
ADMIN_USER=admin
ADMIN_PASS=altere_sua_senha

# === Neon PostgreSQL ===
# Opcional: URL completa (postgresql://user:pass@host/db?sslmode=require)
# DB_DSN=

DB_HOST=ep-xxxxx.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=sua_senha_neon
DB_SSLMODE=require
DB_TIMEZONE=America/Sao_Paulo
# DB_ENDPOINT=ep-xxxxx

# === PIX / EfiBank ===
PIX_CLIENT_ID=
PIX_CLIENT_SECRET=
